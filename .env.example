# AeroSense Configuration
# Copy this to .env and fill in values

# Application mode: LIVE or DEMO
# LIVE: attempts real API calls to CPCB/weather services
# DEMO: uses realistic synthetic data (clearly labelled)
APP_MODE=DEMO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./data/aerosense.db

# CPCB data.gov.in API key (free registration at https://data.gov.in)
# Required for LIVE mode
CPCB_API_KEY=

# NASA FIRMS Map Key (For Stubble/Wildfire Satellite Feeds)
FIRMS_MAP_KEY=

# AeroSense AI Intelligence Model Settings
# Enter your Google Gemini API key or OpenAI API key.
# If left blank, AeroSense automatically operates using the built-in
# Spatio-Temporal Physics-Informed Coupled ML Reasoning Engine.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# Logging
LOG_LEVEL=INFO

